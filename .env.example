# ---- Steam ----
STEAM_USER=id-not-email             # Steam account username
STEAM_PASSWORD=password             # Steam account password
STEAM_BRANCH=public                 # branch ("creatordlc" for CDLCs)
STEAM_BRANCH_PASSWORD=              # beta branch password, if required

# ---- Server ----
ARMA_BINARY=./arma3server_x64       # server binary to launch
ARMA_CONFIG=main.cfg                # server.cfg filename inside configs/
ARMA_BASIC_CONFIG=basic.cfg         # basic.cfg filename inside configs/
ARMA_PROFILE=main                   # profile name
ARMA_WORLD=empty                    # world to load on start
ARMA_LIMITFPS=100                   # max server FPS (5–1000)
ARMA_PARAMS=                        # extra CLI flags, space-separated
ARMA_CDLC=                          # cDLC codes, semicolons (e.g. csla;gm)
PORT=2302                           # game port (also uses +1 through +4)
SKIP_INSTALL=false                  # skip auto-update on restart

# ---- Mods ----
MODS_LOCAL=true                     # load mods from mods/ and servermods/
MODS_PRESET=                        # preset filename from presets/ (or URL)
CLEAR_KEYS=true                     # wipe keys/ before each start
EXTRACT_MOD_KEYS=true               # copy *.bikey from mods to keys/

# ---- Headless clients ----
HEADLESS_CLIENTS=0                  # number of headless clients
HEADLESS_CLIENTS_PROFILE="$profile-hc-$i"  # profile pattern ($profile, $i, $ii)
